{
  "name": "nain-legacy-modernizer-demo",
  "private": true,
  "version": "0.0.0",
  "description": "Static visual demo for NainLegacyModernizer. Build-time dependencies only.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/build.ts",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "serve": "node scripts/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
