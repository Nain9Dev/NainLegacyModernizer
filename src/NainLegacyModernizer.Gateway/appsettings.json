{
  "Urls": "http://127.0.0.1:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Modernizer": {
    "LegacyBaseAddress": "http://127.0.0.1:5000",
    "ModernBaseAddress": "http://127.0.0.1:5001",
    "EmitDiagnosticHeaders": true,
    "AwaitShadowReplay": false,
    "ShadowTimeoutSeconds": 10,
    "MaxCapturedBodyBytes": 1048576,
    "DecimalTolerance": 0.0,
    "StoreCapacity": 2000,
    "Cutover": {
      "MinimumSamples": 20,
      "MinimumParityRatio": 0.995
    },
    "Routes": [
      {
        "Id": "invoices",
        "PathPattern": "/api/invoices/{**rest}",
        "Description": "Invoice lookup. Not started: still served by the monolith.",
        "Mode": "Legacy",
        "SampleRequests": [
          { "Method": "GET", "Path": "/api/invoices/INV-2024-0001" },
          { "Method": "GET", "Path": "/api/invoices/INV-2024-0002" }
        ]
      },
      {
        "Id": "orders",
        "PathPattern": "/api/orders/{**rest}",
        "Description": "Order aggregate. Rewritten in .NET 10 and under shadow verification.",
        "Mode": "Shadow",
        "CanaryPercent": 20,
        "FieldAliases": {
          "OrderID": "id",
          "CustomerRef": "customerReference",
          "TotalAmount": "totalAmount",
          "Lines": "items",
          "SKU": "sku",
          "Qty": "quantity",
          "UnitPrice": "unitPrice"
        },
        "IgnoredFields": [ "Source", "GeneratedBy", "ServedAt", "CreatedAtUtc" ],
        "SampleRequests": [
          { "Method": "GET", "Path": "/api/orders/ORD-1001" },
          { "Method": "GET", "Path": "/api/orders/ORD-1002" },
          { "Method": "GET", "Path": "/api/orders/ORD-1003" },
          { "Method": "POST", "Path": "/api/orders", "JsonBody": "{\"orderId\":\"ORD-9001\",\"totalAmount\":199.90}" }
        ]
      },
      {
        "Id": "customers",
        "PathPattern": "/api/customers/{**rest}",
        "Description": "Customer balance with VAT. Shadow audit is catching a rounding difference.",
        "Mode": "Shadow",
        "CanaryPercent": 10,
        "FieldAliases": {
          "CustomerID": "id",
          "Name": "name",
          "NetBalance": "netBalance",
          "TaxAmount": "taxAmount",
          "GrossBalance": "grossBalance"
        },
        "IgnoredFields": [ "Source", "GeneratedBy", "ServedAt" ],
        "SampleRequests": [
          { "Method": "GET", "Path": "/api/customers/CUST-501" },
          { "Method": "GET", "Path": "/api/customers/CUST-502" }
        ]
      },
      {
        "Id": "catalog",
        "PathPattern": "/api/catalog/{**rest}",
        "Description": "Product catalog. Parity proven, now receiving a canary share of live traffic.",
        "Mode": "Canary",
        "CanaryPercent": 30,
        "FieldAliases": { "SKU": "sku", "Name": "name", "Price": "price", "Currency": "currency" },
        "IgnoredFields": [ "Source", "GeneratedBy", "ServedAt" ],
        "SampleRequests": [
          { "Method": "GET", "Path": "/api/catalog/SKU-100" },
          { "Method": "GET", "Path": "/api/catalog/SKU-200" }
        ]
      },
      {
        "Id": "pricing",
        "PathPattern": "/api/pricing/{**rest}",
        "Description": "Quote engine. Fully migrated: the monolith no longer sees this traffic.",
        "Mode": "Modern",
        "SampleRequests": [
          { "Method": "GET", "Path": "/api/pricing/quote?sku=SKU-100&qty=3" },
          { "Method": "GET", "Path": "/api/pricing/quote?sku=SKU-200&qty=12" }
        ]
      }
    ]
  }
}
