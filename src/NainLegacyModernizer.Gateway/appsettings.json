{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "orders-migrated-route": {
        "ClusterId": "modern-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "legacy-fallback-route": {
        "ClusterId": "legacy-cluster",
        "Order": 1000,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "modern-cluster": {
        "Destinations": {
          "modern-dest": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "legacy-cluster": {
        "Destinations": {
          "legacy-dest": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}
